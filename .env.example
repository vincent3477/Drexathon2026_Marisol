# Copy to .env and fill in real values. Never commit the .env file.

# Set to 1 to run every external call (Drex, frontier LLM) as a deterministic
# mock; no API keys are needed. Unset or 0 = real API calls.
MOCK_MODE=1

# --- Drex (Nace.AI) ---
# Get a key at https://console.nace.ai (shown once when created).
NACE_API_KEY=nace_sk_replace_me
# API root; defaults to https://console.nace.ai if unset.
# NACE_BASE_URL=https://console.nace.ai
# Drex Max model id.
# NACE_MODEL=drex-max-v1.1

# --- Second model: DeepInfra (escalation + repro drafts only) ---
# Default provider is "deepinfra": the OpenAI-compatible endpoint at
# https://api.deepinfra.com/v1/openai. Get a key at https://deepinfra.com.
DEEPINFRA_API_KEY=di-replace-me
# Optional: vision model (default: Qwen/Qwen3-VL-30B-A3B-Instruct) and endpoint.
# FRONTIER_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# FRONTIER_BASE_URL=https://api.deepinfra.com/v1/openai

# Alternative providers: set FRONTIER_PROVIDER and FRONTIER_API_KEY.
# FRONTIER_PROVIDER=openai
# FRONTIER_API_KEY=sk-replace-me
# FRONTIER_BASE_URL=https://api.openai.com/v1
# FRONTIER_PROVIDER=anthropic
# FRONTIER_API_KEY=sk-ant-replace-me
